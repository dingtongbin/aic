import print

// L4 审计补锚点：**运算符与比较语义**（此前位运算完全缺失、下标复合赋值静默算错、
// @packed 比较发出非法 C）。全部为可运行锚点，输出与调度/平台无关。
@packed
@derive(Compare)
class Pair {
    var a i32
    var b i32
}

func main() {
    // 位运算（§一 7/8/9 级）
    print.println(6 & 3)
    print.println(6 | 3)
    print.println(6 ^ 3)
    print.println(~0)
    // 移位（4 级）：结果类型跟随左操作数；计数越界 = trap（见 trap/778）
    var n i32 = 3
    print.println(1 << n)
    print.println(256 >> 2)
    // 下标复合赋值：必须先读回当前元素再算（曾经直接存 rhs = 静默算错）
    var xs i32[] = [10, 20]
    xs[0] += 5
    xs[1] *= 3
    print.println(xs[0])
    print.println(xs[1])
    // @packed 比较：`==` 字段逐项；`<` 等需 @derive(Compare)
    var p Pair = Pair{a: 1, b: 2}
    var q Pair = Pair{a: 1, b: 2}
    var r Pair = Pair{a: 2, b: 0}
    print.println(p == q)
    print.println(p == r)
    print.println(p < r)
    print.println(r > p)
}
