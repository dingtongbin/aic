import print

// L4-f 合法形态：多字段负载用 @packed 值类型承载（值语义、无对象头 ⇒ 与单字段负载同一 ABI 形态）。
enum Shape { Circle(i32), Rect(Size) }

@packed
class Size {
    var w i32
    var h i32
}

func area(s Shape) -> i32 {
    return match s {
        Shape.Circle(r) => r * r * 3,
        Shape.Rect(sz) => sz.w * sz.h,
    }
}

func main() {
    print.println(area(Shape.Circle(2)))
    print.println(area(Shape.Rect(Size{w: 3, h: 4})))
}
