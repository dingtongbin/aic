import print

func main() {
    var s set[i32] = set.new()
    s.add(5)
    s.add(6)
    var total i32 = 0
    for x in s {
        total = total + x
        print.println(x)
    }
    print.println(total)

    var m map[str]i32 = map.new()
    m.put("a", 1)
    m.put("b", 2)
    var keys usize = 0
    for k in m {
        print.println(k)
        keys = keys + 1
    }
    print.println(keys)
}
