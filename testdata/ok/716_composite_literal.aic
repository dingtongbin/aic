import print

class Point {
    var x i32
    var y i32
}

class Line {
    var a Point
    var b Point
}

func main() {
    var p = Point{x: 1, y: 2}
    var q = Point{x: 5}
    var l = Line{a: p, b: q}
    print.println(p.x)
    print.println(q.x)
    print.println(l.a.y)
    print.println(l.b.y)
}
