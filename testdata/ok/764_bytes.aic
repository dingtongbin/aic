import print

// N7 锚点：`bytes` —— 区域托管、可增长的字节缓冲（核心设计 §16 N7）。
//   ① 越界**写** = 增长并补零（与容器同源）；
//   ② 越界**读** = trap（trap/760 锚点）；
//   ③ 与 str 的转换**必须显式**（toStr / fromStr）。
func main() {
    var b = bytes.new()
    print.println(b.len())
    b.append(65) // 'A'
    b.append(66)
    print.println(b.len())
    print.println(b.get(0))
    print.println(b.get(1))

    // 越界写：增长并补零（索引 4 之前补 0）
    b.set(4, 90)
    print.println(b.len())
    print.println(b.get(3))
    print.println(b.get(4))

    print.println(b.toStr())

    var c = bytes.fromStr("hello")
    print.println(c.len())
    print.println(c.toStr())

    var d = bytes.withCap(8)
    print.println(d.len())
    d.appendBytes(c)
    print.println(d.len())
    print.println(d.toStr())

    var s = d.slice(1, 3)
    print.println(s.len())
    print.println(s.toStr())

    d.clear()
    print.println(d.len())
}
