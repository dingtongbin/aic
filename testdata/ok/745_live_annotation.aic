import print

class Buf {
    var n i32
}

// @live：对象在外一层区域创建 → 活过 region 块的弹出（§五 R4）。
// 不写 @live 而把它带出 region 块 = 存储点守卫 trap（trap/003 一类）。
func main() -> Err {
    var kept Buf = nil
    region {
        var @live b = Buf{n: 7}
        kept = b
    }
    // region 已弹出：@live 的 b 仍存活（它在更外层区域）
    print.println(kept.n)
    return nil
}
