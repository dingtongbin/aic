import print

func main() {
    var xs i32[] = []
    var i usize = 0
    for i < 5 {
        xs[i] = i32(i) * 3
        i = i + 1
    }
    print.println(xs.len())
    var total i32 = 0
    var j usize = 0
    for j < xs.len() {
        total = total + xs[j]
        j = j + 1
    }
    print.println(total)
    print.println(xs.isEmpty())
}
