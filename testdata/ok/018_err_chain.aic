import fmt

enum DbErr: ErrCode { Query, Connect }

func readRow() -> (str, Err) {
    return "", Err(DbErr.Query, "syntax error")
}

func loadUser() -> (str, Err) {
    var v, e = readRow()
    if e.code != 0 {
        return "", Err.wrap(DbErr.Connect, "load user", e)
    }
    return v, nil
}

func main() {
    var v, e = loadUser()
    if e.code != 0 {
        fmt.eprintln("code={e.code()} msg={e.msg}")
        return
    }
    fmt.println(v)
}
