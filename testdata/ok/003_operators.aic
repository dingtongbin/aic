import fmt
import str

// 运算符封闭集：无 ? / ++ / 链式赋值 / 三元 / & 取址 / * 解引用 / :: / ...
// 优先级：catch < 赋值 < || < && < | < ^ < & < 相等 < 关系 < 移位 < 加减 < 乘除模 < 一元 < 后缀
func main() {
    fmt.println("{6 & 3}")
    fmt.println("{6 | 3}")
    fmt.println("{6 ^ 3}")
    fmt.println("{~0}")
    var n i32 = 3
    fmt.println("{1 << n}")
    fmt.println("{256 >> 2}")
    fmt.println("{1 < 2 && 3 > 2 || false}")
    var xs i32[] = [10, 20]
    xs[0] += 5
    xs[1] *= 3
    fmt.println("{xs[0]}")
    fmt.println("{xs[1]}")
}
