import fmt

enum AppErr: ErrCode { Nope }

func inner() -> Err {
    return Err(AppErr.Nope, "boom")
}

// 语句位自动传播：单返回值 fallible 调用免写 check
// return 位自动传播：结果列表完全一致时尾传播
func outer() -> Err {
    inner()
    return inner()
}

// 多返回值 fallible 在语句位 / return 位 = 编译错误
func multi() -> (i64, Err) {
    return 1, nil
}

func main() -> Err {
    outer()
    return nil
}
