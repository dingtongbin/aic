// cat — 原样输出输入（v2 面：check / 多返回绑定）。
//
// 用法：cat <文件>；不给文件时读标准输入。
// 注：表面只有 print.println（§十四），故输出末尾恒有一个换行。
import print
import str
import os

func readInput() -> (str, Err) {
    var args = os.args()
    if args.len() >= 2 {
        var content, err = os.readFile(args[1])
        return content, err
    }
    var piped, err = os.readStdin()
    return piped, err
}

func main() -> Err {
    var text, err = readInput()
    if err.code != 0 {
        print.println(str.concat("cat: ", err.msg))
        return err
    }
    print.println(text)
    return nil
}
