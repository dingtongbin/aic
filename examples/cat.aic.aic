// cat — 原样输出输入
// 用法：cat <文件>；不给文件时读标准输入
// fmt.print 不追加换行——这就是为什么 println 之外必须有 print
import fmt
import str
import os

func readInput() -> (str, Err) {
    var args = os.args()
    if args.len() >= 2 {
        return os.readFile(args[1])
    }
    return os.readStdin()
}

func main() -> Err {
    var text, e = readInput()
    if e.code != 0 {
        fmt.eprintln("cat: {e.msg}")
        return e
    }
    fmt.print(text)
    return nil
}
