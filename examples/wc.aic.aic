// wc — 统计行数、词数、字节数
// 用法：wc [文件...]
import fmt
import str
import os

struct Counts { var lines i64    var words i64    var bytes i64 }

func count(text str) -> Counts {
    var c Counts = Counts{lines: 0, words: 0, bytes: text.len()}
    for ch in text.codepoints() {
        if ch == rune(10) {
            c.lines = c.lines + 1
            c.words = c.words + 1
        }
    }
    var parts = text.trim().split(" ")
    if parts.len() == 1 && parts[0] == "" {
        return c
    }
    c.words = parts.len()
    return c
}

func main() -> Err {
    var args = os.args()
    if args.len() < 2 {
        fmt.eprintln("wc: need a file")
        return Err(OsErr.NotExist, "no input file")
    }
    var text, e = os.readFile(args[1])
    if e.code != 0 {
        fmt.eprintln("wc: {e.msg}")
        return e
    }
    var c = count(text)
    fmt.println("{c.lines} {c.words} {c.bytes} {args[1]}")
    return nil
}
