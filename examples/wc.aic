// wc — 统计行数、词数、字节数（v2 面：for-in 区间 / check / 多返回）。
//
// 用法：wc <文件>；不给文件时读标准输入。
import print
import str
import os

func countWords(line str) -> i64 {
    if str.trim(line).len() == 0 {
        return 0
    }
    var words i64 = 0
    var parts = str.split(line, " ")
    for i in 0..parts.len() {
        if str.trim(parts[i]).len() != 0 {
            words += 1
        }
    }
    return words
}

func count(input str) -> (i64, i64, i64) {
    if input.len() == 0 {
        return 0, 0, 0
    }
    var lines = str.split(input, "\n")
    // 末尾换行是「终止最后一行」而不是「开始新的一行」。
    var counted usize = lines.len()
    if str.endsWith(input, "\n") {
        counted -= 1
    }
    var lineCount i64 = 0
    var words i64 = 0
    for i in 0..counted {
        lineCount += 1
        words += countWords(lines[i])
    }
    return lineCount, words, i64(input.len())
}

func readInput() -> (str, Err) {
    var args = os.args()
    if args.len() >= 2 {
        var content, err = os.readFile(args[1])
        return content, err
    }
    var piped, err = os.readStdin()
    return piped, err
}

func main() -> Err {
    var text, err = readInput()
    if err.code != 0 {
        print.println(str.concat("wc: ", err.msg))
        return err
    }
    var lines, words, bytes = count(text)
    print.println(lines)
    print.println(words)
    print.println(bytes)
    return nil
}
