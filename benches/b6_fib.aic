import print
import os
import str

// B6 递归核 · fib(naive)（默认 n = 42；二叉递归、无缓存）。
// 考调用约定（实参/返回/帧），与 benches/c/b6_fib.c 逐行同构。
func fib(n i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func main() -> Err {
    var n i64 = 42
    var args = os.args()
    if args.len() >= 2 {
        var v, e = str.toI64(args[1])
        if e.code == 0 {
            n = v
        }
    }
    print.println(fib(n))
    return nil
}
