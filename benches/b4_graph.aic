import print
import os
import str

// B4 分配：百万节点对象图 —— 构建 + 遍历 + **整块回收**（区域模型的核心卖点）。
// 与 benches/c/b4_graph.c 同构：同样的链表结构、同样的构建/遍历次序、同样的校验和；
// 差别只在回收方式（AIC = region 弹出整块回收；C 基线 = 逐节点 free）。
class Node {
    var value i64
    var next Node
}

func build(n i64) -> Node {
    var head Node = nil
    var i i64 = 0
    for i < n {
        var node = Node{value: i, next: head}
        head = node
        i = i + 1
    }
    return head
}

func traverse(head Node) -> i64 {
    var sum i64 = 0
    var cur Node = head
    for cur != nil {
        sum = sum + cur.value
        cur = cur.next
    }
    return sum
}

func main() -> Err {
    var n i64 = 1000000
    var args = os.args()
    if args.len() >= 2 {
        var v, e = str.toI64(args[1])
        if e.code == 0 {
            n = v
        }
    }
    var checksum i64 = 0
    region {
        var head = build(n)
        checksum = traverse(head)
    }
    print.println(checksum)
    return nil
}
