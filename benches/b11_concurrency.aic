import print
import os
import str

// C1: 并发基准（AIC）。模式：spawn（任务吞吐）/ pingpong（切换延迟）/ churn（长驻留）
// 形态说明：各模式放独立函数里 —— if 的两支都直接以 scope 收尾会踩 CIR 汇合点
// 丢标签的缺陷（build/audit/ds/D24_skeleton.aic 已最小化，R23 立案）。
func work(n i64) -> i64 {
    var acc i64 = 0
    var i i64 = 0
    for i < n {
        acc = acc + i
        i = i + 1
    }
    return acc
}

func run_spawn(rounds i64) {
    var r i64 = 0
    for r < rounds {
        scope {
            spawn work(1000)
            spawn work(1000)
            spawn work(1000)
            spawn work(1000)
        }
        r = r + 1
    }
    print.println(0)
}

func run_pingpong(n i64) {
    var ab chan[i64] = chan[i64].new()
    var ba chan[i64] = chan[i64].new()
    scope {
        spawn pinger(ab, ba, n)
        spawn ponger(ab, ba, n)
    }
    print.println(n)
}

func run_churn(n i64) {
    var r i64 = 0
    for r < n {
        scope {
            spawn churn_once()
        }
        r = r + 1
    }
    print.println(n)
}

func pinger(out chan[i64], back chan[i64], n i64) {
    var i i64 = 0
    for i < n {
        out.send(1)
        var v, ok = back.recv()
        if !ok {
            return
        }
        i = i + 1
    }
}

func ponger(inn chan[i64], out chan[i64], n i64) {
    var i i64 = 0
    for i < n {
        var v, ok = inn.recv()
        if !ok {
            return
        }
        out.send(2)
        i = i + 1
    }
}

// churn_once：任务自己在区域里建/回收 100 个元素（驻留判据：RSS 不随轮数涨）
func churn_once() {
    region {
        var xs i64[] = []
        var i i64 = 0
        for i < 100 {
            xs.append(i)
            i = i + 1
        }
    }
}

func main() {
    var args = os.args()
    var mode = "spawn"
    if args.len() >= 2 {
        mode = args[1]
    }
    var n i64 = 500
    if args.len() >= 3 {
        var v, e = str.toI64(args[2])
        if e.code == 0 {
            n = v
        }
    }
    if mode == "spawn" {
        run_spawn(n)
    } else if mode == "pingpong" {
        run_pingpong(n)
    } else if mode == "churn" {
        run_churn(n)
    }
}
